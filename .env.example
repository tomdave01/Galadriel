# Optional Application Insights export; disabled when unset.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Microsoft Foundry project inference. FOUNDRY_MODEL is the current documented name.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=
FOUNDRY_RESOURCE_ID=
# Used only when DefaultAzureCredential cannot authenticate to Foundry.
FOUNDRY_API_KEY=

# Optional Azure AI Translator; disabled unless set to 1.
AZURE_TRANSLATOR_ENABLED=0
AZURE_TEXT_TRANSLATION_ENDPOINT=
AZURE_TEXT_TRANSLATION_REGION=

# Optional Azure AI Content Safety; disabled unless set to 1.
AZURE_CONTENT_SAFETY_ENABLED=0
AZURE_CONTENT_SAFETY_ENDPOINT=

# Exact Static Web Apps origin(s), comma-separated. Leave blank for same-origin hosting.
CORS_ALLOWED_ORIGINS=

# Optional local video replay inputs. Set both JSON paths together.
CLIP_EVENTS_PATH=
CLIP_FRAMES_PATH=
CLIP_VIDEO_PATH=

# Azure Event Hubs (DefaultAzureCredential; no connection string required).
EVENTHUB_NAMESPACE=
EVENTHUB_NAME=match-events
EVENTHUB_CONSUMER_GROUP='$Default'

# Azure Cosmos DB (DefaultAzureCredential; account endpoint is not a secret).
COSMOS_ENDPOINT=
COSMOS_DATABASE=overseer
COSMOS_MATCH_STATE_CONTAINER=match-state
COSMOS_NARRATION_CACHE_CONTAINER=narration-cache
MATCH_SNAPSHOT_INTERVAL_SECONDS=30
PORT=8000

# Optional Web PubSub fan-out; SSE remains enabled as the default transport.
WEB_PUBSUB_CONNECTION=
WEB_PUBSUB_HUB=overseer

# Feed simulator settings. Processed clip data is published before synthetic data.
SIMULATOR_SPEED=20
SIMULATOR_CLIP_EVENTS_PATH=
SIMULATOR_CLIP_FRAMES_PATH=

# Azure deployment script overrides; defaults are generated by infra/deploy.sh.
AZURE_SUBSCRIPTION_ID=
LOCATION=eastus2
SWA_LOCATION=eastus2
RESOURCE_SUFFIX=
RESOURCE_GROUP=
LOG_WORKSPACE=
APP_INSIGHTS=
EVENTHUB_NAMESPACE_NAME=
COSMOS_ACCOUNT=
COSMOS_MATCH_CONTAINER=match-state
COSMOS_CACHE_CONTAINER=narration-cache
ACR_NAME=
ACA_ENVIRONMENT=
CONTAINER_APP=
SIMULATOR_JOB=
PULL_IDENTITY=
IMAGE_NAME=overseer-api
IMAGE_TAG=phase4
STATIC_WEB_APP=
FOUNDRY_ROLE="Foundry User"
