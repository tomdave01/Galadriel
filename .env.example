# Leave empty to use the local MOCK narration path.
LLM_MOCK=1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional Application Insights export; disabled when unset.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Optional Azure AI Translator; disabled unless set to 1.
AZURE_TRANSLATOR_ENABLED=0
AZURE_TEXT_TRANSLATION_ENDPOINT=
AZURE_TEXT_TRANSLATION_APIKEY=
AZURE_TEXT_TRANSLATION_REGION=

# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional local video replay inputs. Set both JSON paths together.
CLIP_EVENTS_PATH=
CLIP_FRAMES_PATH=
CLIP_VIDEO_PATH=
